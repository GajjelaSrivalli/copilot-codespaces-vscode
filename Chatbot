# app.py (Flask RESTful API)

from flask import Flask, request, jsonify
from flask_restful import Resource, Api
from langchain.document_loaders import WebBaseLoader
from langchain.embeddings.openai import OpenAIEmbeddings
from langchain.vectorstores import FAISS
from langchain.chains import RetrievalQA
from langchain.llms import OpenAI
import os

# Set your OpenAI API key
os.environ["OPENAI_API_KEY"] = "YOUR_OPENAI_API_KEY"  # Replace with your actual key

app = Flask(__name__)
api = Api(app)

class Chatbot(Resource):
    def __init__(self):
        # 1. Load data from the URL
        loader = WebBaseLoader("https://brainlox.com/courses/category/technical")
        documents = loader.load()

        # 2. Create embeddings and store in a vector store
        embeddings = OpenAIEmbeddings()
        self.db = FAISS.from_documents(documents, embeddings)

        # 3. Create a RetrievalQA chain
        self.llm = OpenAI() # You can customize the LLM here (e.g., temperature)
        self.qa = RetrievalQA.from_chain_type(llm=self.llm, chain_type="stuff", retriever=self.db.as_retriever())

    def post(self):
        try:
            user_question = request.get_json()['question']
            result = self.qa.run(user_question)
            return jsonify({"response": result})
        except KeyError:
            return jsonify({"error": "Missing 'question' in request body"}), 400
        except Exception as e: # Catching general exceptions for better error handling
            return jsonify({"error": str(e)}), 500


api.add_resource(Chatbot, '/api/chat')

if __name__ == '__main__':
    app.run(debug=True)  # Set debug=False in production
